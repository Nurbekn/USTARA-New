            "exec": [
              "const body = pm.response.json();",
              "pm.test('Barber Register: HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Barber profili va pending holati bor', () => { pm.expect(body.barber).to.be.an('object'); pm.expect(body.barber.id).to.be.a('number'); pm.expect(body.barber.phone).to.eql(pm.environment.get('barberPhone')); pm.expect(body.barber.verification_status).to.eql('pending'); });",
