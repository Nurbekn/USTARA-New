      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('Customer Register: HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Customer profili javobda bor', () => { pm.expect(body.customer).to.be.an('object'); pm.expect(body.customer.id).to.be.a('number'); pm.expect(body.customer.phone).to.eql(pm.environment.get('customerPhone')); });",
              "pm.test('Parol javobga chiqmagan', () => { pm.expect(body.customer).not.to.have.property('password'); pm.expect(pm.response.text()).not.to.include(pm.environment.get('customerPassword')); });",
              "pm.environment.set('customerProfileId', String(body.customer.id));"
            ]
          }
        }
      ]
    },
