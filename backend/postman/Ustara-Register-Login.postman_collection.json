        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionToken\": \"{{customerSessionToken}}\",\n  \"firstName\": \"{{customerFirstName}}\",\n  \"lastName\": \"{{customerLastName}}\"\n}",
          "options": {
            "raw": {
