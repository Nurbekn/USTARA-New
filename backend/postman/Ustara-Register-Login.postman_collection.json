    {
      "name": "Customer Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('Customer Login: HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Token va customer javobi mavjud', () => { pm.expect(body.token).to.be.a('string').and.not.empty; pm.expect(body.customer.id).to.eql(Number(pm.environment.get('customerProfileId'))); });",
              "pm.test('Parol javobga chiqmagan', () => { pm.expect(body.customer).not.to.have.property('password'); pm.expect(pm.response.text()).not.to.include(pm.environment.get('customerPassword')); });",
              "const part = body.token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
              "const payload = JSON.parse(atob(part + '='.repeat((4 - part.length % 4) % 4)));",
              "pm.test('JWT role customer va ID users.id', () => { pm.expect(payload.role).to.eql('customer'); pm.expect(payload.id).to.be.a('number'); pm.expect(payload.profileId).to.eql(Number(pm.environment.get('customerProfileId'))); });",
              "pm.environment.set('customerToken', body.token);",
              "pm.environment.set('customerAccountId', String(payload.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
