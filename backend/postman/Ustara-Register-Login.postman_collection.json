              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/registration/verify"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Verify: HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer Registration Complete",
      "request": {
