  "item": [
    {
      "name": "Customer Registration Start",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = String(Math.floor(1000000 + Math.random() * 9000000));",
              "pm.environment.set('customerPhone', '+99890' + suffix);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.test('Start: HTTP 201', () => pm.response.to.have.status(201));",
              "pm.variables.set('customerSessionToken', body.sessionToken);",
              "if (body.testOtp) pm.variables.set('customerOtp', body.testOtp);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{customerPhone}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"role\": \"customer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/registration/start"
        }
      }
    },
    {
      "name": "Customer Registration Verify",
